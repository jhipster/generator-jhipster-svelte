<%_
	const entityFakeData = generateFakeData('cypress');
	const containsBinaryField = fields.find(field => (field.fieldTypeBinary && !field.blobContentTypeText));
	const containsMandatoryField = fields.find(field => field.fieldValidationRequired);
	const containsFieldValidation = containsMandatoryField || fields.find(field => (field.fieldValidationMinLength
			|| field.fieldValidationMaxLength
			|| field.fieldValidationMin
			|| field.fieldValidationMax
			|| (!field.fieldValidationRequired && field.fieldTypeNumeric)));
	const placeHolderText = 'lorem ipsum';
	const getMinLengthText = function(len) {
		return placeHolderText.substr(0, len > 1 ? len-1 : 0);
	}
	const getMaxLengthText = function(len) {
		let maxLengthText = placeHolderText;
		while(maxLengthText.length < len) {
			maxLengthText+= placeHolderText;
		}
		return maxLengthText;
	}
_%>
import { test, expect } from '@playwright/test';
<%_ if (authenticationType === 'jwt') { _%>
import { loginByApi } from '<%= clientRootFolder !== '' ? '../../../' : '../../' %>support/auth.js';
<%_ } else { _%>
import { loginByApi } from '<%= clientRootFolder !== '' ? '../../../' : '../../' %>support/auth.js';
<%_ } _%>

const ADMIN_USERNAME = process.env.ADMIN_USERNAME || 'admin';
const ADMIN_PASSWORD = process.env.ADMIN_PASSWORD || 'admin';

test.describe('Create <%= entityInstance %> page', () => {
	test.beforeEach(async ({ page, request }) => {
<%_ if (authenticationType === 'jwt') { _%>
		const token = await loginByApi(request, ADMIN_USERNAME, ADMIN_PASSWORD);
		await page.goto('/');
		await page.evaluate(t => localStorage.setItem('authToken', t), token);
<%_ } else { _%>
		await loginByApi(page.request, ADMIN_USERNAME, ADMIN_PASSWORD);
<%_ } _%>
		await page.goto('/entities/<%= entityFolderName %>/new');
	});

	test('should greets with Create <%= entityInstance %> title', async ({ page }) => {
		const title = page.getByTestId('<%= entityInstance %>Title');
		await expect(title).toBeVisible();
		await expect(title).toContainText('Create <%= entityClassHumanized %>');
	});

<%_ if (containsMandatoryField) { _%>
	test('should require mandatory fields', async ({ page }) => {
		const createBtn = page.getByTestId('add<%= entityAngularName %>Form').getByRole('button', { name: 'Create <%= entityClassHumanized %>' });
		await expect(createBtn).toBeDisabled();
	});

<%_ } _%>
<%_ if (containsFieldValidation) { _%>
	test('should validate field values', async ({ page }) => {
<%_
		for (field of fields.filter(field => !field.id)) {
			const fieldValue = !entityFakeData ? field.generateFakeData('cypress') : entityFakeData[field.fieldName];
			if (fieldValue === undefined) {
				warning(`Error generating a value for field ${field.fieldName}`);
			}
_%>
	<%_ if (field.fieldValidationRequired) { _%>
		const <%= field.fieldName %>Input = page.getByTestId('add<%= entityAngularName %>Form').locator('[name=<%= field.fieldName %>]');
		await <%= field.fieldName %>Input.fill('<%= fieldValue %>');
		await <%= field.fieldName %>Input.fill('');
		await <%= field.fieldName %>Input.blur();
		const <%= field.fieldName %>Error = page.getByTestId('<%= field.fieldName %>-error');
		await expect(<%= field.fieldName %>Error).toBeVisible();
		await expect(<%= field.fieldName %>Error).toContainText('<%= field.fieldNameHumanized %> is mandatory');
	<%_ } _%>
	<%_ if (field.fieldValidationMinLength) { _%>

		const <%= field.fieldName %>MinInput = page.getByTestId('add<%= entityAngularName %>Form').locator('[name=<%= field.fieldName %>]');
		await <%= field.fieldName %>MinInput.fill('<%= getMinLengthText(field.fieldValidateRulesMinlength) %>');
		await <%= field.fieldName %>MinInput.blur();
		const <%= field.fieldName %>MinError = page.getByTestId('<%= field.fieldName %>-error');
		await expect(<%= field.fieldName %>MinError).toBeVisible();
		await expect(<%= field.fieldName %>MinError).toContainText('<%= field.fieldNameHumanized %> should be greater than <%= field.fieldValidateRulesMinlength %> characters');
	<%_ } _%>
	<%_ if (field.fieldValidationMaxLength) { _%>

		const <%= field.fieldName %>MaxInput = page.getByTestId('add<%= entityAngularName %>Form').locator('[name=<%= field.fieldName %>]');
		await <%= field.fieldName %>MaxInput.fill('<%= getMaxLengthText(field.fieldValidateRulesMaxlength) %>');
		await <%= field.fieldName %>MaxInput.blur();
		const <%= field.fieldName %>MaxError = page.getByTestId('<%= field.fieldName %>-error');
		await expect(<%= field.fieldName %>MaxError).toBeVisible();
		await expect(<%= field.fieldName %>MaxError).toContainText('<%= field.fieldNameHumanized %> cannot be longer than <%= field.fieldValidateRulesMaxlength %> characters');
	<%_ } _%>
	<%_ if (field.fieldTypeNumeric && !field.fieldValidationRequired) { _%>

		const <%= field.fieldName %>NumInput = page.getByTestId('add<%= entityAngularName %>Form').locator('[name=<%= field.fieldName %>]');
		await <%= field.fieldName %>NumInput.fill('1');
		await <%= field.fieldName %>NumInput.fill('');
		await <%= field.fieldName %>NumInput.fill('-');
		await <%= field.fieldName %>NumInput.blur();
		const <%= field.fieldName %>NumError = page.getByTestId('<%= field.fieldName %>-error');
		await expect(<%= field.fieldName %>NumError).toBeVisible();
		await expect(<%= field.fieldName %>NumError).toContainText('<%= field.fieldNameHumanized %> should be numeric');
	<%_ } _%>
	<%_ if (field.fieldTypeNumeric && field.fieldValidationMin) { _%>

		const <%= field.fieldName %>MinValInput = page.getByTestId('add<%= entityAngularName %>Form').locator('[name=<%= field.fieldName %>]');
		await <%= field.fieldName %>MinValInput.fill('<%= Number(field.fieldValidateRulesMin) - 1 %>');
		await <%= field.fieldName %>MinValInput.blur();
		const <%= field.fieldName %>MinValError = page.getByTestId('<%= field.fieldName %>-error');
		await expect(<%= field.fieldName %>MinValError).toBeVisible();
		await expect(<%= field.fieldName %>MinValError).toContainText('<%= field.fieldNameHumanized %> should be at least <%= field.fieldValidateRulesMin %>');
	<%_ } _%>
	<%_ if (field.fieldTypeNumeric && field.fieldValidationMax) { _%>

		const <%= field.fieldName %>MaxValInput = page.getByTestId('add<%= entityAngularName %>Form').locator('[name=<%= field.fieldName %>]');
		await <%= field.fieldName %>MaxValInput.fill('<%= Number(field.fieldValidateRulesMax) + 1 %>');
		await <%= field.fieldName %>MaxValInput.blur();
		const <%= field.fieldName %>MaxValError = page.getByTestId('<%= field.fieldName %>-error');
		await expect(<%= field.fieldName %>MaxValError).toBeVisible();
		await expect(<%= field.fieldName %>MaxValError).toContainText('<%= field.fieldNameHumanized %> cannot be more than <%= field.fieldValidateRulesMax %>');
	<%_ } _%>
<%_ 	} _%>
	});

<%_ } _%>
	test('should navigate back to the <%= entityInstance %> list page', async ({ page }) => {
		await page.locator('[name=cancelBtn]').click();

		await expect(page).toHaveURL('/entities/<%= entityFolderName %>');
		const title = page.getByTestId('<%= entityInstance %>Title');
		await expect(title).toBeVisible();
		await expect(title).toContainText('<%= entityClassPluralHumanized %>');
	});
});
