import { test, expect } from '@playwright/test';
<%_ if (authenticationType === 'jwt') { _%>
import { loginByApi } from '../../support/auth.js';
<%_ } else { _%>
import { loginByApi } from '../../support/auth.js';
<%_ } _%>

const ADMIN_USERNAME = process.env.ADMIN_USERNAME || 'admin';
const ADMIN_PASSWORD = process.env.ADMIN_PASSWORD || 'admin';

test.describe('Change user password', () => {
	test.beforeEach(async ({ page, request }) => {
<%_ if (authenticationType === 'jwt') { _%>
		const token = await loginByApi(request, ADMIN_USERNAME, ADMIN_PASSWORD);
		await page.goto('/');
		await page.evaluate(t => localStorage.setItem('authToken', t), token);
<%_ } else { _%>
		await loginByApi(page.request, ADMIN_USERNAME, ADMIN_PASSWORD);
<%_ } _%>
		await page.goto('/account/password');
	});

	test('should greets with Change password title', async ({ page }) => {
		await expect(page.getByTestId('passwordTitle')).toHaveText('Change password');
	});

	test('should require mandatory fields to be filled', async ({ page }) => {
		const updateBtn = page.getByTestId('passwordForm').getByRole('button', { name: 'Update password' });
		await expect(updateBtn).toBeDisabled();
	});

	test('should require current password', async ({ page }) => {
		const input = page.getByTestId('passwordForm').locator('[name=currentPassword]');
		await input.fill('admin');
		await input.fill('');
		await input.blur();

		const error = page.getByTestId('currentPassword-error');
		await expect(error).toBeVisible();
		await expect(error).toContainText('Password is mandatory');
	});

	test('should require new password', async ({ page }) => {
		const input = page.getByTestId('passwordForm').locator('[name=newPassword]');
		await input.fill('admin');
		await input.fill('');
		await input.blur();

		const error = page.getByTestId('newPassword-error');
		await expect(error).toBeVisible();
		await expect(error).toContainText('Password is mandatory');
	});

	test('should require to confirm new password', async ({ page }) => {
		const input = page.getByTestId('passwordForm').locator('[name=newPasswordConfirm]');
		await input.fill('admin');
		await input.fill('');
		await input.blur();

		const error = page.getByTestId('newPasswordConfirm-error');
		await expect(error).toBeVisible();
		await expect(error).toContainText('Password is mandatory');
	});

	test('should require new and confirm passwords to match', async ({ page }) => {
		const newPwd = page.getByTestId('passwordForm').locator('[name=newPassword]');
		await newPwd.fill('abcd');
		await newPwd.blur();

		const confirmPwd = page.getByTestId('passwordForm').locator('[name=newPasswordConfirm]');
		await confirmPwd.fill('defg');
		await confirmPwd.blur();

		const error = page.getByTestId('newPasswordConfirm-error');
		await expect(error).toBeVisible();
		await expect(error).toContainText('Password and its confirmation do not match');
	});

	test('should update user password', async ({ page }) => {
		const form = page.getByTestId('passwordForm');
		await form.locator('[name=currentPassword]').fill('admin');
		await form.locator('[name=currentPassword]').blur();
		await form.locator('[name=newPassword]').fill('admin');
		await form.locator('[name=newPassword]').blur();
		await form.locator('[name=newPasswordConfirm]').fill('admin');
		await form.locator('[name=newPasswordConfirm]').blur();

		const updateBtn = form.getByRole('button', { name: 'Update password' });
		await expect(updateBtn).not.toBeDisabled();
		await updateBtn.click();

		await expect(page.getByTestId('successMsg')).toContainText('Password changed!');
	});
});
