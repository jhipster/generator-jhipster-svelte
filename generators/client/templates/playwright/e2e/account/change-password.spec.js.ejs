import { test, expect } from '@playwright/test';

test.use({ storageState: '.auth/admin.json' });

test.describe('Change user password', () => {
	test.beforeEach(async ({ page }) => {
		await page.goto('/account/password');
	});

	test('should greets with Change password title', async ({ page }) => {
		await expect(page.getByTestId('passwordTitle')).toHaveText('Change password');
	});

	test('should require mandatory fields to be filled', async ({ page }) => {
		await expect(page.getByTestId('passwordForm').getByRole('button', { name: 'Update password' })).toBeDisabled();
	});

	test('should require current password', async ({ page }) => {
		const form = page.getByTestId('passwordForm');
		const field = form.locator('[name="currentPassword"]');
		await field.fill('admin');
		await field.fill('');
		await field.blur();
		await expect(page.getByTestId('currentPassword-error')).toBeVisible();
		await expect(page.getByTestId('currentPassword-error')).toContainText('Password is mandatory');
	});

	test('should require new password', async ({ page }) => {
		const form = page.getByTestId('passwordForm');
		const field = form.locator('[name="newPassword"]');
		await field.fill('admin');
		await field.fill('');
		await field.blur();
		await expect(page.getByTestId('newPassword-error')).toBeVisible();
		await expect(page.getByTestId('newPassword-error')).toContainText('Password is mandatory');
	});

	test('should require to confirm new password', async ({ page }) => {
		const form = page.getByTestId('passwordForm');
		const field = form.locator('[name="newPasswordConfirm"]');
		await field.fill('admin');
		await field.fill('');
		await field.blur();
		await expect(page.getByTestId('newPasswordConfirm-error')).toBeVisible();
		await expect(page.getByTestId('newPasswordConfirm-error')).toContainText('Password is mandatory');
	});

	test('should require new and confirm passwords to match', async ({ page }) => {
		const form = page.getByTestId('passwordForm');
		await form.locator('[name="newPassword"]').fill('abcd');
		await form.locator('[name="newPassword"]').blur();
		await form.locator('[name="newPasswordConfirm"]').fill('defg');
		await form.locator('[name="newPasswordConfirm"]').blur();
		await expect(page.getByTestId('newPasswordConfirm-error')).toBeVisible();
		await expect(page.getByTestId('newPasswordConfirm-error')).toContainText('Password and its confirmation do not match');
	});

	test('should update user password', async ({ page }) => {
		const form = page.getByTestId('passwordForm');
		await form.locator('[name="currentPassword"]').fill('admin');
		await form.locator('[name="currentPassword"]').blur();
		await form.locator('[name="newPassword"]').fill('admin');
		await form.locator('[name="newPassword"]').blur();
		await form.locator('[name="newPasswordConfirm"]').fill('admin');
		await form.locator('[name="newPasswordConfirm"]').blur();
		await expect(form.getByRole('button', { name: 'Update password' })).toBeEnabled();
		await form.getByRole('button', { name: 'Update password' }).click();
		await expect(page.getByTestId('successMsg')).toContainText('Password changed!');
	});
});
