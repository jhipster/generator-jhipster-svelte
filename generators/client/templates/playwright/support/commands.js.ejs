}
<%_ } else if (authenticationType === 'oauth2') { _%>
/**
 * Login via OAuth2 UI flow.
 */
export async function loginByUi(page, username = ADMIN_USERNAME, password = ADMIN_PASSWORD) {
	await page.goto('/');
	await page.getByRole('link', { name: 'Sign in' }).click();
	await page.getByLabel('Username').fill(username);
	await page.getByLabel('Password').fill(password);
	await page.getByRole('button', { name: 'Sign In' }).click();
	await page.waitForURL('/');
}

/**
 * Logout via OAuth2.
 */
export async function logoutByApi(page) {
	await page.getByTestId('svlAcctMenu').getByTestId('svlAccountLink').click();
	await page.getByTestId('svlSignoutLink').click();
	await page.waitForURL('/');
}
