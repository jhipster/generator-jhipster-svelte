<%_ if (authenticationType === 'session') { _%>
export async function loginByApi(request, username, password) {
	const csrfResponse = await request.get('api/authenticate');
	const cookies = (await csrfResponse.headersArray()).filter(h => h.name.toLowerCase() === 'set-cookie');
	let xsrfToken = '';
	for (const cookie of cookies) {
		const match = cookie.value.match(/XSRF-TOKEN=([^;]+)/);
		if (match) {
			xsrfToken = match[1];
			break;
		}
	}

	const loginResponse = await request.post('api/authentication', {
		form: {
			username,
			password,
			'remember-me': 'true',
		},
		headers: {
			'X-XSRF-TOKEN': xsrfToken,
		},
	});

	if (loginResponse.status() !== 200) {
		throw new Error(`Login failed with status ${loginResponse.status()}`);
	}

	const accountResponse = await request.get('api/account');
	if (accountResponse.status() !== 200) {
		throw new Error(`Account fetch failed with status ${accountResponse.status()}`);
	}
}

export async function getXsrfToken(request) {
	const cookies = (await request.storageState()).cookies;
	const xsrfCookie = cookies.find(c => c.name === 'XSRF-TOKEN');
	return xsrfCookie ? xsrfCookie.value : '';
}
<%_ } else if (authenticationType === 'jwt') { _%>
export async function loginByApi(request, username, password) {
	const response = await request.post('api/authenticate', {
		data: {
			username,
			password,
			'remember-me': false,
		},
	});

	if (response.status() !== 200) {
		throw new Error(`Login failed with status ${response.status()}`);
	}

	const body = await response.json();
	return body.id_token;
}

export function authHeaders(token) {
	return {
		Authorization: `Bearer ${token}`,
	};
}
