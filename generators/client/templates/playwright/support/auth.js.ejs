export async function loginByApi(request, page, username, password) {
	const authResponse = await request.get('/oauth2/authorization/oidc', {
		maxRedirects: 0,
	});
	const authorizeUrl = authResponse.headers()['location'];

	if (!authorizeUrl) {
		throw new Error('No redirect location found for OAuth2 login');
	}

	const url = new URL(authorizeUrl);
	const origin = url.origin;

	if (origin.includes('okta')) {
		await oktaLogin(request, page, authorizeUrl, origin, username, password);
	} else if (origin.includes('auth0')) {
		await auth0Login(request, page, origin, username, password);
	} else {
		await keycloakLogin(request, page, username, password);
	}
}

async function keycloakLogin(request, page, username, password) {
	const authPageResponse = await request.get('/oauth2/authorization/oidc', {
		maxRedirects: 5,
	});
	const html = await authPageResponse.text();
	const formActionMatch = html.match(/action="([^"]+)"/);
	if (!formActionMatch) {
		throw new Error('Could not find login form action URL');
	}
	const loginUrl = formActionMatch[1].replace(/&amp;/g, '&');

	await request.post(loginUrl, {
		form: { username, password },
		maxRedirects: 0,
	});

	await request.get('/oauth2/authorization/oidc', {
		maxRedirects: 5,
	});
}

async function auth0Login(request, page, origin, username, password) {
	const authPageResponse = await request.get('/oauth2/authorization/oidc', {
		maxRedirects: 5,
	});
	const html = await authPageResponse.text();
	const stateMatch = html.match(/name="state"\s+value="([^"]+)"/);
	if (!stateMatch) {
		throw new Error('Could not find state input in auth0 login form');
	}

	await request.post(`${origin}/u/login`, {
		form: {
			state: stateMatch[1],
			action: 'default',
			username,
			password,
		},
		maxRedirects: 5,
	});

	await request.get('/oauth2/authorization/oidc', {
		maxRedirects: 5,
	});
}

async function oktaLogin(request, page, authorizeUrl, origin, username, password) {
	const authnResponse = await request.post(`${origin}/api/v1/authn`, {
		data: { username, password },
		maxRedirects: 0,
	});
	const authnBody = await authnResponse.json();
	const sessionToken = authnBody.sessionToken;

	await request.get(`${authorizeUrl}&sessionToken=${sessionToken}`, {
		maxRedirects: 5,
	});
}

