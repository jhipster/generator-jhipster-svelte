import { test, expect } from '@playwright/test'
import { getByTestId, getByName, unregisterServiceWorkers } from '../../support/test-utils.js'

test.describe('Forgot password', () => {
	test.beforeEach(async ({ page }) => {
		await unregisterServiceWorkers(page)
		await page.goto('/account/reset/init')
	})

	test('should greets with forgot password title', async ({ page }) => {
		const forgotPwdTitle = getByTestId(page, 'forgotPwdTitle')
		await expect(forgotPwdTitle).toBeVisible()
		await expect(forgotPwdTitle).toContainText('Reset your password')
	})

	test('should verify instructions to reset password', async ({ page }) => {
		const warningMsg = getByTestId(page, 'warningMsg')
		await expect(warningMsg).toBeVisible()
		await expect(warningMsg).toContainText(
			"Enter your user account's verified email address."
		)
	})

	test('should require mandatory fields', async ({ page }) => {
		const forgotPwdForm = getByTestId(page, 'forgotPwdForm')
		const sendBtn = forgotPwdForm.locator('text=Send password reset email')
		await expect(sendBtn).toBeDisabled()
	})

	test('should require email', async ({ page }) => {
		const forgotPwdForm = getByTestId(page, 'forgotPwdForm')
		const email = forgotPwdForm.locator('[name=email]')
		await email.fill('admin')
		await email.fill('')
		await email.blur()

		const error = getByTestId(page, 'email-error')
		await expect(error).toBeVisible()
		await expect(error).toContainText('Email is mandatory')
	})

	test('should reset user password', async ({ page }) => {
		const forgotPwdForm = getByTestId(page, 'forgotPwdForm')
		await forgotPwdForm.locator('[name=email]').fill('admin@localhost.org')
		await forgotPwdForm.locator('[name=email]').press('Enter')

		const successMsg = getByTestId(page, 'successMsg')
		await expect(successMsg).toBeVisible()
		await expect(successMsg).toContainText(
			'Check your email for details on how to reset your password.'
		)
		await expect(forgotPwdForm).toHaveCount(0)
	})
})
