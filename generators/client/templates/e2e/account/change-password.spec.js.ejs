import { test, expect } from '@playwright/test'
import { getByTestId, getByName, unregisterServiceWorkers } from '../support/test-utils.js'
import { loginByApi, ADMIN_USERNAME, ADMIN_PASSWORD } from '../support/auth-utils.js'

test.describe('Change user password', () => {
	test.beforeEach(async ({ page }) => {
		await unregisterServiceWorkers(page)
		await loginByApi(page, ADMIN_USERNAME, ADMIN_PASSWORD)
		await page.goto('/account/password')
	})

	test('should greets with Change password title', async ({ page }) => {
		const passwordTitle = getByTestId(page, 'passwordTitle')
		await expect(passwordTitle).toHaveText('Change password')
	})

	test('should require mandatory fields to be filled', async ({ page }) => {
		const passwordForm = getByTestId(page, 'passwordForm')
		const updateBtn = passwordForm.locator('text=Update password')
		await expect(updateBtn).toBeDisabled()
	})

	test('should require current password', async ({ page }) => {
		const passwordForm = getByTestId(page, 'passwordForm')
		const currentPassword = passwordForm.locator('[name=currentPassword]')
		await currentPassword.fill('admin')
		await currentPassword.fill('')
		await currentPassword.blur()

		const error = getByTestId(page, 'currentPassword-error')
		await expect(error).toBeVisible()
		await expect(error).toContainText('Password is mandatory')
	})

	test('should require new password', async ({ page }) => {
		const passwordForm = getByTestId(page, 'passwordForm')
		const newPassword = passwordForm.locator('[name=newPassword]')
		await newPassword.fill('admin')
		await newPassword.fill('')
		await newPassword.blur()

		const error = getByTestId(page, 'newPassword-error')
		await expect(error).toBeVisible()
		await expect(error).toContainText('Password is mandatory')
	})

	test('should require to confirm new password', async ({ page }) => {
		const passwordForm = getByTestId(page, 'passwordForm')
		const confirmPassword = passwordForm.locator('[name=newPasswordConfirm]')
		await confirmPassword.fill('admin')
		await confirmPassword.fill('')
		await confirmPassword.blur()

		const error = getByTestId(page, 'newPasswordConfirm-error')
		await expect(error).toBeVisible()
		await expect(error).toContainText('Password is mandatory')
	})

	test('should require new and confirm passwords to match', async ({ page }) => {
		const passwordForm = getByTestId(page, 'passwordForm')
		await passwordForm.locator('[name=newPassword]').fill('abcd')
		await passwordForm.locator('[name=newPassword]').blur()
		await passwordForm.locator('[name=newPasswordConfirm]').fill('defg')
		await passwordForm.locator('[name=newPasswordConfirm]').blur()

		const error = getByTestId(page, 'newPasswordConfirm-error')
		await expect(error).toBeVisible()
		await expect(error).toContainText('Password and its confirmation do not match')
	})

	test('should update user password', async ({ page }) => {
		const passwordForm = getByTestId(page, 'passwordForm')
		await passwordForm.locator('[name=currentPassword]').fill('admin')
		await passwordForm.locator('[name=currentPassword]').blur()
		await passwordForm.locator('[name=newPassword]').fill('admin')
		await passwordForm.locator('[name=newPassword]').blur()
		await passwordForm.locator('[name=newPasswordConfirm]').fill('admin')
		await passwordForm.locator('[name=newPasswordConfirm]').blur()

		const updateBtn = passwordForm.locator('text=Update password')
		await expect(updateBtn).not.toBeDisabled()
		await updateBtn.click()

		const successMsg = getByTestId(page, 'successMsg')
		await expect(successMsg).toContainText('Password changed!')
	})
})
