import { test, expect } from '@playwright/test'
import { getByTestId, unregisterServiceWorkers } from './support/test-utils.js'

test.describe('Footer', () => {
	test.beforeEach(async ({ page }) => {
		await unregisterServiceWorkers(page)
		await page.goto('/')
	})

	test('should display copyright message', async ({ page }) => {
		const copyrightMsg = getByTestId(page, 'copyrightMsg')
		await expect(copyrightMsg).toBeVisible()
		await expect(copyrightMsg).toContainText('Copyright \u00a9 2023 JHipster. All Rights Reserved')
	})
})
