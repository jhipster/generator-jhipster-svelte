<%_ } else { _%>
export async function loginByApi(page, username, password) {
	const response = await page.request.get('/oauth2/authorization/oidc', {
		maxRedirects: 0,
	})
	const authorizeUrl = response.headers()['location']

	const url = new URL(authorizeUrl)
	const origin = url.origin

	if (origin.includes('okta')) {
		await oktaLogin(page, authorizeUrl, origin, username, password)
	} else if (origin.includes('auth0')) {
		await auth0Login(page, origin, username, password)
	} else {
		await keycloakLogin(page, username, password)
	}
}

async function auth0Login(page, origin, username, password) {
	const response = await page.request.get('/oauth2/authorization/oidc', {
		maxRedirects: 5,
	})
	const body = await response.text()
	const stateMatch = body.match(/name="state"\s+value="([^"]+)"/)
	const state = stateMatch ? stateMatch[1] : ''

	await page.request.post(`${origin}/u/login`, {
		form: {
			state,
			action: 'default',
			username,
			password,
		},
		maxRedirects: 5,
	})

	await page.request.get('/oauth2/authorization/oidc', {
		maxRedirects: 5,
	})
	await page.goto('/')
}

async function keycloakLogin(page, username, password) {
	const response = await page.request.get('/oauth2/authorization/oidc', {
		maxRedirects: 5,
	})
	const body = await response.text()
	const formActionMatch = body.match(/action="([^"]+)"/)
	const formUrl = formActionMatch ? formActionMatch[1].replace(/&amp;/g, '&') : ''

	await page.request.post(formUrl, {
		form: {
			username,
			password,
		},
		maxRedirects: 0,
	})

	await page.request.get('/oauth2/authorization/oidc', {
		maxRedirects: 5,
	})
}

async function oktaLogin(page, authorizeUrl, origin, username, password) {
	const authnResponse = await page.request.post(`${origin}/api/v1/authn`, {
		data: {
			username,
			password,
		},
		maxRedirects: 0,
	})
	const authnBody = await authnResponse.json()
	const sessionToken = authnBody.sessionToken

	await page.request.get(`${authorizeUrl}&sessionToken=${sessionToken}`, {
		maxRedirects: 5,
	})
}

