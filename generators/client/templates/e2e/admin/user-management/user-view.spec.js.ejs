import { test, expect } from '@playwright/test'
import { getByTestId, getByName, unregisterServiceWorkers } from '../../support/test-utils.js'
import { loginByApi, apiSave, apiDelete, ADMIN_USERNAME, ADMIN_PASSWORD } from '../../support/auth-utils.js'

test.describe('User view details page', () => {
	let randomUser

	test.beforeEach(async ({ page }) => {
		await unregisterServiceWorkers(page)
		randomUser = 'test' + Date.now()
		await loginByApi(page, ADMIN_USERNAME, ADMIN_PASSWORD)

		const user = await apiSave(page, 'api/admin/users', {
			login: randomUser,
			firstName: 'John',
			lastName: 'Doe',
			email: `${randomUser}@localhost.org`,
			activated: true,
			authorities: ['ROLE_USER'],
		})

		await page.goto(`/admin/user-management/${user.login}/view`)
	})

	test.afterEach(async ({ page }) => {
		await apiDelete(page, `api/admin/users/${randomUser}`)
	})

	test('should display user account details', async ({ page }) => {
		const userMgmtTitle = getByTestId(page, 'userMgmtTitle')
		await expect(userMgmtTitle).toBeVisible()
		await expect(userMgmtTitle).toContainText(`User Details [ ${randomUser} ]`)

		const tableContainer = page.locator('div.table')
		const cells = tableContainer.locator('.table-cell')
		await expect(cells).toHaveCount(18)
		await expect(cells.nth(1)).toContainText(randomUser)
		await expect(cells.nth(3)).toContainText('John')
		await expect(cells.nth(5)).toContainText('Doe')
		await expect(cells.nth(7)).toContainText(`${randomUser}@localhost.org`)
		await expect(cells.nth(9)).toContainText('admin')
		await expect(cells.nth(13)).toContainText('admin')
		await expect(cells.nth(17)).toContainText('ROLE_USER')
	})

	test('should navigate back to the user list page', async ({ page }) => {
		await page.locator('[name=backBtn]').click()

		const userMgmtTitle = getByTestId(page, 'userMgmtTitle')
		await expect(userMgmtTitle).toBeVisible()
		await expect(userMgmtTitle).toContainText('Users')
	})
})
