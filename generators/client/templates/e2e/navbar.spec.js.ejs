test.describe('Navbar', () => {
	test.beforeEach(async ({ page }) => {
		await unregisterServiceWorkers(page)
		await page.goto('/')
	})

	test.describe('unauthenticated user', () => {
		test('should display application name', async ({ page }) => {
			const appName = getByTestId(page, 'svlAppName')
			await expect(appName).toBeVisible()
			await expect(appName).toContainText('<%= baseName %>')
		})

		test('should display application version', async ({ page }) => {
			const appVersion = getByTestId(page, 'svlAppVersion')
			await expect(appVersion).toBeVisible()
			await expect(appVersion).toContainText('DEV')
		})

		test('should not display navigation toggle button', async ({ page }) => {
			const navBtn = getByTestId(page, 'svlNavBtn')
			await expect(navBtn).not.toBeVisible()
		})

		test('should not display account menu', async ({ page }) => {
			const acctMenu = getByTestId(page, 'svlAcctMenu')
			await expect(acctMenu).toHaveCount(0)
		})

		test('should display sign in link', async ({ page }) => {
			const loginLink = getByTestId(page, 'svlLoginLink')
			await expect(loginLink).toBeVisible()
			await expect(loginLink).toContainText('Sign in')
		})

<%_ if (authenticationType !== 'oauth2' && !skipUserManagement) { _%>
