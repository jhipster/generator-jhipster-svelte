import { test, expect } from '@playwright/test'
import { getByTestId, unregisterServiceWorkers } from './support/test-utils.js'
import { loginByApi, ADMIN_USERNAME, ADMIN_PASSWORD<%_ if (authenticationType === 'oauth2') { _%>, logoutByApi<%_ } _%> } from './support/auth-utils.js'

test.describe('Routes', () => {
	test.beforeEach(async ({ page }) => {
		await unregisterServiceWorkers(page)
	})

	test.describe('unauthenticated user', () => {
<%_ if (authenticationType !== 'oauth2' && !skipUserManagement) { _%>
		test('should not allow navigation to settings page', async ({ page }) => {
			await page.goto('/account/settings')

			await expect(page).toHaveURL(/\/login/)
			const signInTitle = getByTestId(page, 'signInTitle')
			await expect(signInTitle).toBeVisible()
			await expect(signInTitle).toContainText('Sign in to <%= baseName %>')
		})

		test('should not allow navigation to user management page', async ({ page }) => {
			await page.goto('/admin/user-management')

			await expect(page).toHaveURL(/\/login/)
			const signInTitle = getByTestId(page, 'signInTitle')
			await expect(signInTitle).toBeVisible()
			await expect(signInTitle).toContainText('Sign in to <%= baseName %>')
		})
<%_ } _%>
<%_ if (authenticationType !== 'oauth2') { _%>

		test('should not allow navigation to Loggers page', async ({ page }) => {
			await page.goto('/admin/logger')

			await expect(page).toHaveURL(/\/login/)
			const signInTitle = getByTestId(page, 'signInTitle')
			await expect(signInTitle).toBeVisible()
			await expect(signInTitle).toContainText('Sign in to <%= baseName %>')
		})
<%_ } _%>

		test('should allow navigation to home page', async ({ page }) => {
			await page.goto('/')

			await expect(page).toHaveURL('/')
			const welcomeTitle = getByTestId(page, 'welcomeTitle')
			await expect(welcomeTitle).toBeVisible()
			await expect(welcomeTitle).toContainText('Welcome, JHipster Svelte!')
		})
	})

	test.describe('authenticated user', () => {
		test.beforeEach(async ({ page }) => {
			await unregisterServiceWorkers(page)
			await loginByApi(page, ADMIN_USERNAME, ADMIN_PASSWORD)
		})

<%_ if (authenticationType === 'oauth2') { _%>
		test.afterEach(async ({ page }) => {
			await logoutByApi(page)
		})

<%_ } _%>
		test('should not allow navigation to login page', async ({ page }) => {
<%_ if (authenticationType === 'oauth2') { _%>
			await page.goto('/oauth2/authorization/oidc')
<%_ } else { _%>
			await page.goto('/login')
<%_ } _%>

			await expect(page).toHaveURL('/')
			const welcomeTitle = getByTestId(page, 'welcomeTitle')
			await expect(welcomeTitle).toBeVisible()
			await expect(welcomeTitle).toContainText('Welcome, JHipster Svelte!')
		})

<%_ if (authenticationType !== 'oauth2' && !skipUserManagement) { _%>
		test('should not allow navigation to register page', async ({ page }) => {
			await page.goto('/account/register')

			await expect(page).toHaveURL('/')
			const welcomeTitle = getByTestId(page, 'welcomeTitle')
			await expect(welcomeTitle).toBeVisible()
			await expect(welcomeTitle).toContainText('Welcome, JHipster Svelte!')
		})

<%_ } _%>
		test('should allow navigation to home page', async ({ page }) => {
			await page.goto('/')

			await expect(page).toHaveURL('/')
			const welcomeTitle = getByTestId(page, 'welcomeTitle')
			await expect(welcomeTitle).toBeVisible()
			await expect(welcomeTitle).toContainText('Welcome, JHipster Svelte!')
		})
	})

<%_ if (authenticationType !== 'oauth2') { _%>
	test.describe('navigation context', () => {
		test.beforeEach(async ({ page }) => {
			await page.goto('/admin/logger')
			await expect(page).toHaveURL(/\/login/)
		})

		test('should navigate to saved context', async ({ page }) => {
			const loginForm = getByTestId(page, 'loginForm')
			await loginForm.locator("input[type='checkbox']").first().check()
			await loginForm.locator('[name=username]').fill(ADMIN_USERNAME)
			await loginForm.locator('[name=password]').fill(ADMIN_PASSWORD)
			await loginForm.locator('[name=password]').press('Enter')

			await expect(page).toHaveURL(/\/admin\/logger/)
			const loggersTitle = getByTestId(page, 'loggersTitle')
			await expect(loggersTitle).toBeVisible()
			await expect(loggersTitle).toContainText('Loggers')
		})
	})
<%_ } _%>
})
