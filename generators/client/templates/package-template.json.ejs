{
	"name": "<%= dasherizedBaseName %>",
	"description": "Description for <%= baseName  %>",
	"version": "0.1.0",
	"private": true,
	"license": "UNLICENSED",
	"scripts": {
		"format": "prettier --write \"{,src/**/,cypress/**/,playwright/**/}*.{md,json,js,svelte,css,html,yml}\"",
		"lint": "eslint .",
		"prepare": "husky",
		"lint:fix": "npm run lint --fix",
		"cleanup": "rimraf <%= clientDistDir %>",
		"start": "vite dev --port 9000 --open true",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
<%_ if (cypressTests) { _%>
		"e2e": "npm run e2e:ci -- --headed",
		"e2e:ci": "cypress run --browser chrome",
		"cy:open": "cypress open --e2e --browser chrome",
<%_ } _%>
<%_ if (playwrightTests && !cypressTests) { _%>
		"e2e": "npm run e2e:ci -- --headed",
		"e2e:ci": "playwright test",
		"pw:open": "playwright test --ui",
<%_ } _%>
<%_ if (playwrightTests && cypressTests) { _%>
		"e2e:playwright": "playwright test",
		"e2e:playwright:headed": "playwright test --headed",
		"pw:open": "playwright test --ui",
<%_ } _%>
		"build": "vite build",
		"webapp:build": "npm run build",
		"webapp:prod": "npm run build",
		"webapp:test": "npm run test"
	},
	"type": "module"
}
