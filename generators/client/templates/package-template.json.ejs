{
	"name": "<%= dasherizedBaseName %>",
	"description": "Description for <%= baseName  %>",
	"version": "0.1.0",
	"private": true,
	"license": "UNLICENSED",
	"scripts": {
		"format": "prettier --write \"{,src/**/,<%= this.testFramework %>/**/}*.{md,json,js,svelte,css,html,yml}\"",
		"lint": "eslint .",
		"prepare": "husky",
		"lint:fix": "npm run lint --fix",
		"cleanup": "rimraf <%= clientDistDir %>",
		"start": "vite dev --port 9000 --open true",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"build": "vite build",
		"webapp:build": "npm run build",
		"webapp:prod": "npm run build",
		"webapp:test": "npm run test"
	},
	"type": "module"
}
