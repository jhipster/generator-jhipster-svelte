import { fireEvent, render } from '@testing-library/svelte'
import { screen } from '@testing-library/dom'

import AdminMenu from './admin-menu.svelte'

test('should render administration menu button', () => {
	render(AdminMenu)
	expect(
		screen.getByRole('button', { name: /administration menu/i })
	).toBeInTheDocument()
	expect(screen.getByText(/administration/i)).toBeInTheDocument()
})

test('should not render menu backdrop when closed', () => {
	const { container } = render(AdminMenu)
	expect(container.querySelector('button[tabindex="-1"]')).not.toBeInTheDocument()
})

test('should render menu backdrop after opening menu', async () => {
	const { container } = render(AdminMenu)
	await fireEvent.click(screen.getByRole('button', { name: /administration menu/i }))
	expect(container.querySelector('button[tabindex="-1"]')).toBeInTheDocument()
})

test('should always render loggers menu item', () => {
	render(AdminMenu)
	expect(screen.getByTestId('svlLoggerLink')).toBeInTheDocument()
})

