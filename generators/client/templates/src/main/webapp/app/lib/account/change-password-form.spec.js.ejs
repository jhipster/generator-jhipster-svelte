import { render } from '@testing-library/svelte'
import { screen } from '@testing-library/dom'

import ChangePasswordForm from './change-password-form.svelte'

test('should render change password form with disabled submit button', () => {
	render(ChangePasswordForm)

	expect(screen.getByRole('button', { name: /update password/i })).toBeDisabled()
})

test('should accept currentPassword and newPassword props', () => {
	const { component } = render(ChangePasswordForm, {
		currentPassword: 'existingPass',
		newPassword: 'newPass123',
	})

	expect(component.currentPassword).toBe('existingPass')
	expect(component.newPassword).toBe('newPass123')
})
