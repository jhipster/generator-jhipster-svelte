import { render } from '@testing-library/svelte'
import { screen } from '@testing-library/dom'

import ChangePasswordForm from './change-password-form.svelte'

test('should render the change password form', () => {
	render(ChangePasswordForm)

	expect(screen.getByTestId('password')).toBeInTheDocument()
})

test('should render the current password field', () => {
	render(ChangePasswordForm)

	expect(screen.getByLabelText(/current password/i)).toBeInTheDocument()
})

test('should render the new password field', () => {
	render(ChangePasswordForm)

	expect(screen.getByLabelText(/new password/i)).toBeInTheDocument()
})

test('should render the submit button', () => {
	render(ChangePasswordForm)

	expect(
		screen.getByRole('button', { name: /update password/i })
	).toBeInTheDocument()
})

test('should disable the submit button by default', () => {
	render(ChangePasswordForm)

	expect(
		screen.getByRole('button', { name: /update password/i })
	).toBeDisabled()
})
