import { fireEvent, render, screen } from '@testing-library/svelte'
import ChangePasswordForm from './change-password-form.svelte'

test('requires the current password and matching new passwords', async () => {
	const { container } = render(ChangePasswordForm)
	const inputs = container.querySelectorAll('input[type="password"]')
	expect(inputs).toHaveLength(3)
	const submit = screen.getByRole('button', { name: 'Update password' })
	expect(submit).toBeDisabled()
	await fireEvent.input(inputs[1], { target: { value: 'NewPassword123!' } })
	await fireEvent.input(inputs[2], { target: { value: 'NewPassword123!' } })
	expect(submit).toBeDisabled()
	await fireEvent.input(inputs[0], { target: { value: 'OldPassword123!' } })
	expect(submit).toBeEnabled()
	await fireEvent.input(inputs[2], { target: { value: 'mismatch' } })
	expect(submit).toBeDisabled()
})
