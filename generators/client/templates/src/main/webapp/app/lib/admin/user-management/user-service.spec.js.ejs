<%_
	let testFramework
	if (this.jest) {
		testFramework = 'jest'
_%>
import { jest } from '@jest/globals'

const request = jest.fn()
jest.unstable_mockModule('jhipster-svelte-library/utils', () => ({ request }))

const { default: userService } = await import('./user-service')
<%_
	} else {
		testFramework = 'vi'
_%>
import { vi } from 'vitest'
import { request } from 'jhipster-svelte-library/utils'

import userService from './user-service'

vi.mock('jhipster-svelte-library/utils', () => ({ request: vi.fn() }))
<%_
	}
_%>

beforeEach(() => {
	<%= testFramework %>.clearAllMocks()
})

test('should fetch users with zero-based page and default id sort', () => {
	userService.fetchUserDetails(2, 25, 'login', 'desc')

	expect(request).toHaveBeenCalledWith(
		'http://localhost:8080/api/admin/users?page=1&size=25&sort=login,desc&sort=id,asc'
	)
})

test('should not add default id sort when sorting by id', () => {
	userService.fetchUserDetails(1, 20, 'id', 'asc')

	expect(request).toHaveBeenCalledWith(
		'http://localhost:8080/api/admin/users?page=0&size=20&sort=id,asc'
	)
})

test('should create a user with JSON payload', () => {
	const user = { login: 'user1', email: 'user1@example.com' }

	userService.create(user)

	expect(request).toHaveBeenCalledWith(
		'http://localhost:8080/api/admin/users',
		'POST',
		JSON.stringify(user),
		{
			'Content-Type': 'application/json',
		}
	)
})

test('should update a user with JSON payload', () => {
	const user = { login: 'user1', activated: true }

	userService.update(user)

	expect(request).toHaveBeenCalledWith(
		'http://localhost:8080/api/admin/users',
		'PUT',
		JSON.stringify(user),
		{
			'Content-Type': 'application/json',
		}
	)
})

test('should delete a user by login', () => {
	userService.delete('user1')

	expect(request).toHaveBeenCalledWith(
		'http://localhost:8080/api/admin/users/user1',
		'DELETE'
	)
})

test('should fetch a user by login', () => {
	userService.fetchUserByLogin('user1')

	expect(request).toHaveBeenCalledWith(
		'http://localhost:8080/api/admin/users/user1'
	)
})

test('should fetch authorities', () => {
	userService.fetchAuthorities()

	expect(request).toHaveBeenCalledWith('http://localhost:8080/api/authorities')
})
