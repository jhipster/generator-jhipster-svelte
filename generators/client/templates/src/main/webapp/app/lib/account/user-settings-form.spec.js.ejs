import { render } from '@testing-library/svelte'
import { screen } from '@testing-library/dom'
import userEvent from '@testing-library/user-event'

import UserSettingsForm from './user-settings-form.svelte'

test('should render empty user settings form with disabled submit button', () => {
	render(UserSettingsForm)

	expect(screen.getByRole('textbox', { name: /first name/i })).toHaveValue('')
	expect(screen.getByRole('textbox', { name: /last name/i })).toHaveValue('')
	expect(screen.getByRole('textbox', { name: /email/i })).toHaveValue('')
	expect(screen.getByRole('button', { name: /update settings/i })).toBeDisabled()
})

test('should render populated user settings form', () => {
	render(UserSettingsForm, {
		user: { firstName: 'John', lastName: 'Doe', email: 'john@example.com' },
	})

	expect(screen.getByRole('textbox', { name: /first name/i })).toHaveValue('John')
	expect(screen.getByRole('textbox', { name: /last name/i })).toHaveValue('Doe')
	expect(screen.getByRole('textbox', { name: /email/i })).toHaveValue('john@example.com')
})

test('should display email mandatory validation message', async () => {
	const user = userEvent.setup()
	render(UserSettingsForm)

	const emailInput = screen.getByRole('textbox', { name: /email/i })
	await user.type(emailInput, 'test@example.com{Escape}')
	await user.clear(emailInput)

	expect(await screen.findByText('Email is mandatory')).toBeVisible()
})

test('should display first name max length validation message', async () => {
	const user = userEvent.setup()
	render(UserSettingsForm)

	const firstNameInput = screen.getByRole('textbox', { name: /first name/i })
	await user.type(firstNameInput, 'loremipsumloremipsumloremipsumloremipsumloremipsumlorem{Escape}')

	expect(
		await screen.findByText('First name cannot be longer than 50 characters')
	).toBeVisible()
})

test('should display last name max length validation message', async () => {
	const user = userEvent.setup()
	render(UserSettingsForm)

	const lastNameInput = screen.getByRole('textbox', { name: /last name/i })
	await user.type(lastNameInput, 'loremipsumloremipsumloremipsumloremipsumloremipsumlorem{Escape}')

	expect(
		await screen.findByText('Last name cannot be longer than 50 characters')
	).toBeVisible()
})
