import { fireEvent, render, screen } from '@testing-library/svelte'
import ResetPasswordForm from './reset-password-form.svelte'

test('enables resetting only when password confirmation matches', async () => {
	const { container } = render(ResetPasswordForm)
	const inputs = container.querySelectorAll('input[type="password"]')
	expect(inputs).toHaveLength(2)
	const submit = screen.getByRole('button', { name: 'Reset password' })
	expect(submit).toBeDisabled()
	await fireEvent.input(inputs[0], { target: { value: 'ValidPassword123!' } })
	await fireEvent.input(inputs[1], { target: { value: 'different' } })
	expect(submit).toBeDisabled()
	await fireEvent.input(inputs[1], { target: { value: 'ValidPassword123!' } })
	expect(submit).toBeEnabled()
	await fireEvent.input(inputs[0], { target: { value: '' } })
	expect(submit).toBeDisabled()
})
