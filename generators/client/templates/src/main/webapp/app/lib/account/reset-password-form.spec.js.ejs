import { render } from '@testing-library/svelte'
import { screen } from '@testing-library/dom'

import ResetPasswordForm from './reset-password-form.svelte'

test('should render reset password form with disabled submit button', () => {
	render(ResetPasswordForm)

	expect(screen.getByRole('button', { name: /reset password/i })).toBeDisabled()
})

test('should accept password prop', () => {
	const { component } = render(ResetPasswordForm, { password: 'newPass123' })

	expect(component.password).toBe('newPass123')
})
