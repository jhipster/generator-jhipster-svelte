import { render } from '@testing-library/svelte'
import { screen } from '@testing-library/dom'
import userEvent from '@testing-library/user-event'

import ForgotPasswordForm from './forgot-password-form.svelte'

test('should render forgot password form with disabled submit button', () => {
	render(ForgotPasswordForm)

	expect(
		screen.getByRole('button', { name: /send password reset email/i })
	).toBeDisabled()
})

test('should render email input field', () => {
	render(ForgotPasswordForm)

	expect(screen.getByRole('textbox', { name: /email/i })).toBeInTheDocument()
	expect(screen.getByRole('textbox', { name: /email/i })).toHaveValue('')
})

test('should render form with pre-filled email', () => {
	render(ForgotPasswordForm, { email: 'user@example.com' })

	expect(screen.getByRole('textbox', { name: /email/i })).toHaveValue('user@example.com')
})

test('should display email mandatory validation message', async () => {
	const user = userEvent.setup()
	render(ForgotPasswordForm)

	const emailInput = screen.getByRole('textbox', { name: /email/i })
	await user.type(emailInput, 'test@example.com{Escape}')
	await user.clear(emailInput)

	expect(await screen.findByText('Email is mandatory')).toBeVisible()
})

test('should display invalid email validation message', async () => {
	const user = userEvent.setup()
	render(ForgotPasswordForm)

	const emailInput = screen.getByRole('textbox', { name: /email/i })
	await user.type(emailInput, 'not-an-email{Escape}')

	expect(await screen.findByText('Email address is not valid')).toBeVisible()
})
