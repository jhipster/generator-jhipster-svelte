import { fireEvent, render, screen } from '@testing-library/svelte'
import ForgotPasswordForm from './forgot-password-form.svelte'

test('rejects missing and invalid email addresses before enabling reset', async () => {
	render(ForgotPasswordForm)
	const email = screen.getByLabelText(/^Email/)
	const submit = screen.getByRole('button', { name: 'Send password reset email' })
	expect(submit).toBeDisabled()
	await fireEvent.input(email, { target: { value: 'not-an-email' } })
	expect(submit).toBeDisabled()
	await fireEvent.input(email, { target: { value: 'reader@example.com' } })
	expect(submit).toBeEnabled()
	await fireEvent.input(email, { target: { value: '' } })
	expect(submit).toBeDisabled()
})

test('renders the supplied email address', () => {
	render(ForgotPasswordForm, { email: 'existing@example.com' })
	expect(screen.getByLabelText(/^Email/)).toHaveValue('existing@example.com')
})
