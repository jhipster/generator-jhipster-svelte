<%_ } else { _%>
import { render, waitFor } from '@testing-library/svelte'
import { screen } from '@testing-library/dom'
import userEvent from '@testing-library/user-event'
import { vi } from 'vitest'

import accountService from '$lib/account/account-service'
import PasswordPage from './+page.svelte'

vi.mock('$lib/account/account-service', () => ({
	default: {
		changeAccountPassword: vi.fn(),
	},
}))
<%_ } _%>

async function submitPasswordForm(user) {
	await user.type(document.querySelector('input[name="currentPassword"]'), 'current-secret')
	await user.type(document.querySelector('input[name="newPassword"]'), 'new-secret')
	await user.type(document.querySelector('input[name="newPasswordConfirm"]'), 'new-secret')
	await user.click(screen.getByRole('button', { name: /update password/i }))
}

beforeEach(() => {
	accountService.changeAccountPassword.mockReset()
})

test('should change the password and show a confirmation', async () => {
	accountService.changeAccountPassword.mockResolvedValue()
	const user = userEvent.setup()
	render(PasswordPage)

	await submitPasswordForm(user)

	expect(accountService.changeAccountPassword).toHaveBeenCalledWith('current-secret', 'new-secret')
	await waitFor(() => expect(screen.getByTestId('successMsg')).toHaveTextContent('Password changed!'))
})

test('should clear the current password and show an error when the change fails', async () => {
	accountService.changeAccountPassword.mockRejectedValue(new Error('request failed'))
	const user = userEvent.setup()
	render(PasswordPage)

	await submitPasswordForm(user)

	await waitFor(() => expect(screen.getByTestId('errorMsg')).toBeVisible())
	expect(document.querySelector('input[name="currentPassword"]')).toHaveValue('')
})
